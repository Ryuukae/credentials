{
  "name": "credentials",
  "version": "1.0.0",
  "description": "Certificates and credentials of Adam Ross DeStafeno.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:html && npm run check:data",
    "lint:js": "eslint src scripts \"*.js\" --max-warnings 0",
    "lint:html": "html-validate \"*.html\"",
    "check:data": "node scripts/check-data.js",
    "test": "vitest run",
    "lint:commit": "commitlint --edit",
    "audit": "npm audit --audit-level=high --omit=dev",
    "verify": "npm run format:check && npm run lint && npm test && npm run audit && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "html-validate": "11.18.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "semantic-release": "25.0.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "conventional-changelog-writer": "^9.0.0",
    "minimatch": "^11.0.5"
  }
}
