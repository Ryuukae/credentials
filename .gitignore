# Allow-list: everything is ignored unless it is listed below.
*

!.gitignore
!index.html
!package.json
!package-lock.json
!readme.md
!vite.config.js
!eslint.config.js
!commitlint.config.js
!.prettierrc
!.prettierignore
!.htmlvalidate.json
!.lintstagedrc.json

!.github/
!.github/**

!.husky/
.husky/_
!.husky/pre-commit
!.husky/commit-msg

!src/
!src/**

!public/
!public/**
