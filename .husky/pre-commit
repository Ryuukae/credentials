#!/usr/bin/env bash

# Validate branch name
branch="$(git rev-parse --abbrev-ref HEAD)"
valid="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\/[a-z0-9._-]+$|^(main|dev)$"

if [[ ! $branch =~ $valid ]]; then
  echo "ERROR: Invalid branch name ($branch)."
  echo "Use <type>/<description>, for example feat/add-filter or ci/pipelines."
  exit 1
fi

npx lint-staged
